---
import PageLayout from '../layouts/PageLayout.astro';
import Gallery from '../components/Gallery.astro';
import { url } from '../lib/url';
import rugbyTeam from '../assets/about/rugby-team.jpg';
import gredosLake from '../assets/about/gredos-lake.jpg';
import gredosClimb from '../assets/about/gredos-climb.jpg';

const photos = [
  { src: rugbyTeam, alt: 'Large group photo of the rugby team and supporters on a rugby pitch in Madrid, under the posts.', caption: 'With the rugby team in Madrid.' },
  { src: gredosLake, alt: 'Nicolás with a hiking backpack and sun hat, standing on granite slabs beside a mountain lake under rocky peaks.', caption: 'Sierra de Gredos: by a mountain lake.' },
  { src: gredosClimb, alt: 'Nicolás scrambling up a granite chimney next to a rope, seen from below against a blue sky.', caption: 'Sierra de Gredos: scrambling up the granite.' },
];

// Only skills I can defend in an interview. Grouped for an FPGA reader.
const skills = [
  {
    group: 'HDL and FPGA',
    items: [
      'VHDL',
      'Xilinx Vivado: synthesis, implementation, timing closure and analysis, floorplanning, ILA',
      'Xilinx 7-series DSP48E1 and block RAM primitives',
      'Intel Quartus (porting from)',
    ],
  },
  {
    group: 'Concepts',
    items: [
      'Fixed-point DSP: FIR, Hilbert / analytic signal, NCO, polyphase decimation, bandpass sampling',
      'Timing closure',
      'ADC input networks and anti-aliasing',
      'Current sensing and hardware protections',
      'Power electronics: GaN resonant converters, wireless power transfer',
    ],
  },
  {
    group: 'Embedded',
    items: [
      'C',
      'C++ (ITCH market-data parser)',
      'TI C2000: Code Composer Studio, ePWM, CMPSS, ADC, X-BAR, Trip Zone',
      'SPI, UART',
      'Raspberry Pi and embedded Linux (in progress, AstreLoon)',
    ],
  },
  {
    group: 'Tools',
    items: ['MATLAB: fixed-point modelling, signal processing, data analysis', 'LTspice', 'PLECS', 'Git', 'Linux (daily use)'],
  },
  {
    group: 'Lab',
    items: ['Oscilloscope', 'Logic analyser', 'Signal generator', 'Board bring-up', 'Bench characterisation and calibration'],
  },
];

const certifications = [
  { name: 'IELTS Academic, C1', by: 'British Council', date: 'May 2026 (valid until May 2028)' },
  { name: 'McKinsey.org Forward Program', by: 'McKinsey & Company', date: 'Dec 2025' },
  { name: 'BESTINVER educatio', by: 'Bestinver', date: 'Dec 2024' },
];
---

<PageLayout
  title="About me"
  eyebrow="About"
  description="About Nicolás Izquierdo Arruga: from Madrid, studying electronics in Toulouse, rugby player, skier and trekker."
  lead="A bit about me, away from the project pages."
>
  <h2>Madrid, then Toulouse</h2>
  <p>
    I was born and raised in Madrid. I stayed there for university and studied Industrial Engineering, Electronics
    and Control at the Universidad Politécnica de Madrid. In September 2026 I moved to Toulouse for the MSc ESECA
    (Aeronautics and Space track) at Toulouse INP–ENSEEIHT and INSA Toulouse.
  </p>

  <h2>Sport</h2>
  <p>
    I loved every sport growing up, but the one I have stuck with is rugby. During my university years in Madrid, we
    won the Politécnica rugby cup two years in a row.
  </p>
  <p>
    Away from the pitch, I like skiing and going on treks in the mountains. Last summer I did a two-day hike around
    the Sierra de Gredos.
  </p>
  <Gallery images={photos} fit="cover" />

  <h2>What I like in engineering</h2>
  <p>
    I enjoy working close to the hardware, on the bench, where a design can be tested and debugged on a real board.
    Lately I have been curious about SoCs that combine FPGAs and processors for signal processing, AI on FPGAs and
    embedded systems, AI applied to HDL design and verification, and optoelectronics.
  </p>

  <h2>Skills</h2>
  <div class="skills">
    {
      skills.map((s) => (
        <section class="card">
          <h3>{s.group}</h3>
          <ul>
            {s.items.map((i) => (
              <li>{i}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <h2>Languages</h2>
  <p>Spanish (native) · English (C1, IELTS Academic 2026)</p>

  <h2>Certifications</h2>
  <ul>
    {
      certifications.map((c) => (
        <li>
          <strong>{c.name}</strong> · {c.by} · {c.date}
        </li>
      ))
    }
  </ul>

  <p class="btn-row">
    <a class="btn btn-primary" href={url('/cv')}>CV</a>
    <a class="btn" href={url('/contact')}>Contact</a>
  </p>
</PageLayout>

<style>
  .skills {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }
  .skills h3 {
    margin: 0 0 0.5rem;
  }
  .skills ul {
    padding-left: 1.1rem;
    margin: 0;
    font-size: 0.95rem;
  }
</style>
