---
/**
 * Project page template. Astro generates one page per file in
 * src/content/projects/ (see getStaticPaths below).
 * Sections inside the Markdown are free; the optional extras
 * (gallery, videos, KiCad, links) come from the frontmatter.
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Gallery from '../../components/Gallery.astro';
import Video from '../../components/Video.astro';
import KiCanvas from '../../components/KiCanvas.astro';
import { getProjects, type Project } from '../../lib/projects';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
---

<BaseLayout title={d.title} description={d.summary} type="article">
  <article class="container page">
    <p class="back"><a href={url('/projects')}>← All projects</a></p>

    <header class="project-header">
      <p class="eyebrow">{d.context} · {d.period}</p>
      <h1>{d.title}</h1>
      <p class="lead">{d.summary}</p>
      <div class="meta-row">
        {d.status === 'in-progress' && <span class="status">In progress</span>}
        <ul class="tag-list" aria-label="Tags">
          {d.tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
      </div>
    </header>

    {
      d.cover && (
        <figure class="cover">
          <Image src={d.cover} alt={d.coverAlt ?? ''} widths={[640, 1200, 1600]} sizes="(min-width: 960px) 900px, 100vw" loading="eager" />
          {d.coverCaption && <figcaption>{d.coverCaption}</figcaption>}
        </figure>
      )
    }

    {d.notice && <p class="notice"><strong>Note.</strong> {d.notice}</p>}

    {
      d.keyFacts.length > 0 && (
        <dl class="facts">
          {d.keyFacts.map((f) => (
            <div>
              <dt>{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose content">
      <Content />
    </div>

    {
      d.gallery.length > 0 && (
        <section class="prose-wide">
          <h2>Gallery</h2>
          <Gallery images={d.gallery} />
        </section>
      )
    }

    {
      d.videos.length > 0 && (
        <section class="prose">
          <h2>Videos</h2>
          {d.videos.map((v) => <Video {...v} />)}
        </section>
      )
    }

    {
      d.kicad.length > 0 && (
        <section class="prose">
          <h2>Schematics and PCB</h2>
          {d.kicad.map((k) => <KiCanvas {...k} />)}
        </section>
      )
    }

    {
      d.links.length > 0 && (
        <section class="prose">
          <h2>Links</h2>
          <ul>
            {d.links.map((l) => (
              <li>
                <a href={url(l.url)}>{l.label}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <p class="back bottom"><a href={url('/projects')}>← All projects</a></p>
  </article>
</BaseLayout>

<style>
  .back {
    font-size: 0.95rem;
    margin-bottom: 1.5rem;
  }
  .bottom {
    margin-top: 3rem;
  }
  .project-header {
    margin-bottom: 1.75rem;
  }
  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }
  .status {
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--warn-border);
    background: var(--warn-bg);
  }
  .cover {
    max-width: 56rem;
    margin: 0 0 1.75rem;
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
    margin: 0 0 2rem;
    max-width: 56rem;
  }
  .facts div {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.8rem 1rem;
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    font-weight: 650;
    color: var(--accent);
  }
  .facts dd {
    margin: 0.15rem 0 0;
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.4;
  }
  /* Diagrams and photos in the Markdown body can be wider than the text. */
  .content :global(p:has(> img)) {
    margin: 1.5rem 0;
  }
  .content :global(img) {
    display: block;
    background: #fff;
    border: 1px solid var(--border);
  }
  .content :global(h2) {
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
    margin-top: 2.5rem;
  }
  .prose-wide {
    max-width: 56rem;
  }
</style>
