---
/**
 * Home page navigation drawn as a cartoon FPGA dev board.
 *
 * Each page is a header pin. Drag the red jumper wire from the 3V3 pin
 * onto a page pin: its LED lights up and the page opens. Tapping or
 * clicking a pin (or pressing Enter on it with the keyboard) plugs the
 * wire in automatically. The pins are ordinary links, so the board also
 * works without JavaScript, and the normal menu in the header stays.
 *
 * Pure SVG + a small script; no libraries.
 */
import { url } from '../lib/url';

// One entry per header pin, left to right.
const pins = [
  { label: 'Projects', href: '/projects' },
  { label: 'Course', href: '/engineering-course', title: 'Engineering course' },
  { label: 'Career', href: '/career' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
  { label: 'CV', href: '/cv' },
].map((p, i) => ({ ...p, x: 345 + i * 110, y: 92 }));

// The red wire starts at the 3V3 pin and its free end rests here.
const anchor = { x: 120, y: 452 };
const rest = { x: 255, y: 322 };

// Pins around the FPGA package (x, y, w, h).
const chip = { x: 390, y: 232, s: 220 };
const chipPins: [number, number, number, number][] = [];
for (let i = 0; i < 9; i++) {
  const o = chip.x + 22 + i * 22;
  chipPins.push([o, chip.y - 14, 10, 14], [o, chip.y + chip.s, 10, 14]);
  const v = chip.y + 22 + i * 22;
  chipPins.push([chip.x - 14, v, 14, 10], [chip.x + chip.s, v, 14, 10]);
}
---

<section class="board-wrap" aria-labelledby="board-title">
  <h2 id="board-title" class="visually-hidden">Site map</h2>
  <p class="hint">
    <span aria-hidden="true">🔌</span> Plug the red wire into a pin to open a page. You can also tap a pin, or use the menu
    at the top.
  </p>

  <svg
    class="board"
    viewBox="0 0 1000 560"
    role="group"
    aria-label="Cartoon FPGA board. Each header pin is a link to a page of the site."
    data-anchor={`${anchor.x},${anchor.y}`}
    data-rest={`${rest.x},${rest.y}`}
  >
    <defs>
      <filter id="glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="6" result="b"></feGaussianBlur>
        <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
      </filter>
    </defs>

    <!-- PCB -->
    <rect class="pcb" x="40" y="30" width="920" height="500" rx="26"></rect>
    {[[70, 60], [930, 60], [70, 500], [930, 500]].map(([x, y]) => (
      <g>
        <circle cx={x} cy={y} r="15" class="hole-ring"></circle>
        <circle cx={x} cy={y} r="8" class="hole"></circle>
      </g>
    ))}

    <!-- Silkscreen traces, purely decorative -->
    <g class="trace">
      <path d="M140 330 H 300 V 300 H 390"></path>
      <path d="M140 360 H 320 V 340 H 390"></path>
      <path d="M624 280 H 700 V 330"></path>
      <path d="M624 420 H 760 V 400"></path>
      <path d="M500 232 V 150"></path>
      <path d="M455 232 V 170 H 400 V 150"></path>
      <path d="M545 232 V 170 H 600 V 150"></path>
    </g>

    <!-- USB connector -->
    <rect class="metal" x="22" y="170" width="70" height="56" rx="6"></rect>
    <rect class="metal-dark" x="32" y="184" width="46" height="28" rx="4"></rect>

    <!-- Reset button -->
    <rect class="part-grey" x="110" y="78" width="46" height="46" rx="6"></rect>
    <circle class="btn-red" cx="133" cy="101" r="14"></circle>
    <text class="silk small" x="133" y="146">RESET</text>

    <!-- Power LED, always on -->
    <rect class="led-pwr" x="122" y="248" width="24" height="14" rx="4" filter="url(#glow)"></rect>
    <text class="silk small" x="134" y="284">PWR</text>

    <!-- FPGA -->
    {chipPins.map(([x, y, w, h]) => <rect class="chip-pin" x={x} y={y} width={w} height={h} rx="2"></rect>)}
    <rect class="chip" x={chip.x} y={chip.y} width={chip.s} height={chip.s} rx="14"></rect>
    <circle class="chip-dot" cx={chip.x + 26} cy={chip.y + 26} r="7"></circle>
    <text class="chip-text big" x={chip.x + chip.s / 2} y={chip.y + 112}>NICO-7</text>
    <text class="chip-text" x={chip.x + chip.s / 2} y={chip.y + 146}>FPGA</text>

    <!-- Small parts -->
    <rect class="metal" x="680" y="330" width="64" height="34" rx="16"></rect>
    <text class="silk small" x="712" y="388">100 MHz</text>
    <rect class="chip" x="770" y="230" width="90" height="70" rx="8"></rect>
    <text class="chip-text tiny" x="815" y="271">DDR</text>
    <rect class="chip" x="770" y="370" width="70" height="56" rx="8"></rect>
    <text class="chip-text tiny" x="805" y="404">ADC</text>
    {[[300, 420], [330, 420], [660, 200], [690, 200], [880, 330], [880, 360]].map(([x, y]) => (
      <rect class="cap" x={x} y={y} width="18" height="26" rx="4"></rect>
    ))}

    <!-- Board name -->
    <text class="silk name" x="890" y="470">NICO BOARD</text>
    <text class="silk small end" x="890" y="494">rev A · made in Madrid &amp; Toulouse</text>

    <!-- Power header: 3V3 and GND -->
    <rect class="header" x="90" y="430" width="120" height="44" rx="6"></rect>
    <rect class="pad" x={anchor.x - 11} y={anchor.y - 11} width="22" height="22" rx="3"></rect>
    <rect class="pad" x="169" y="441" width="22" height="22" rx="3"></rect>
    <text class="silk small" x={anchor.x} y="500">3V3</text>
    <text class="silk small" x="180" y="500">GND</text>

    <!-- Page header -->
    <rect class="header" x="300" y="70" width="640" height="44" rx="6"></rect>
    <text class="silk small start" x="300" y="56">PAGES</text>
    {
      pins.map((p) => (
        <a class="pin" href={url(p.href)} data-x={p.x} data-y={p.y} aria-label={`Open ${p.title ?? p.label}`}>
          <rect class="hit" x={p.x - 52} y={p.y - 28} width="104" height="150" rx="10"></rect>
          <rect class="pad" x={p.x - 11} y={p.y - 11} width="22" height="22" rx="3"></rect>
          <text class="silk label" x={p.x} y={p.y + 52}>{p.label}</text>
          <rect class="led" x={p.x - 13} y={p.y + 74} width="26" height="16" rx="5"></rect>
        </a>
      ))
    }

    <!-- Jumper wire -->
    <path class="wire" d=""></path>
    <g class="plug" tabindex="-1" aria-hidden="true">
      <circle class="plug-hit" r="38"></circle>
      <rect class="plug-body" x="-15" y="-15" width="30" height="30" rx="7"></rect>
      <rect class="plug-tip" x="-6" y="-6" width="12" height="12" rx="2"></rect>
    </g>
  </svg>
</section>

<script>
  const svg = document.querySelector<SVGSVGElement>('svg.board');
  if (svg) setup(svg);

  function setup(svg: SVGSVGElement) {
    const wire = svg.querySelector<SVGPathElement>('.wire')!;
    const plug = svg.querySelector<SVGGElement>('.plug')!;
    const pins = [...svg.querySelectorAll<SVGAElement>('a.pin')];
    const [ax, ay] = svg.dataset.anchor!.split(',').map(Number);
    const [rx, ry] = svg.dataset.rest!.split(',').map(Number);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let end = { x: rx, y: ry };
    let busy = false;

    function draw() {
      // Wire leaves the 3V3 pin upwards and enters the plug from below.
      const sag = Math.max(60, Math.abs(end.x - ax) * 0.25);
      wire.setAttribute(
        'd',
        `M${ax} ${ay} C ${ax} ${ay - 160}, ${end.x} ${end.y + sag + 60}, ${end.x} ${end.y + 14}`,
      );
      plug.setAttribute('transform', `translate(${end.x} ${end.y})`);
    }

    function toSvg(e: PointerEvent) {
      const pt = svg.createSVGPoint();
      pt.x = e.clientX;
      pt.y = e.clientY;
      const p = pt.matrixTransform(svg.getScreenCTM()!.inverse());
      return { x: Math.min(990, Math.max(10, p.x)), y: Math.min(550, Math.max(10, p.y)) };
    }

    function nearest(p: { x: number; y: number }) {
      let best: SVGAElement | null = null;
      let dist = 55;
      for (const pin of pins) {
        const d = Math.hypot(Number(pin.dataset.x) - p.x, Number(pin.dataset.y) - p.y);
        if (d < dist) {
          dist = d;
          best = pin;
        }
      }
      return best;
    }

    function animateTo(target: { x: number; y: number }, ms: number) {
      return new Promise<void>((done) => {
        if (reduce || ms === 0) {
          end = { ...target };
          draw();
          return done();
        }
        const from = { ...end };
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / ms);
          const e = 1 - Math.pow(1 - k, 3);
          end = { x: from.x + (target.x - from.x) * e, y: from.y + (target.y - from.y) * e };
          draw();
          if (k < 1) requestAnimationFrame(step);
          else done();
        };
        requestAnimationFrame(step);
      });
    }

    async function plugInto(pin: SVGAElement) {
      if (busy) return;
      busy = true;
      svg.classList.add('touched');
      await animateTo({ x: Number(pin.dataset.x), y: Number(pin.dataset.y) }, 450);
      pins.forEach((p) => p.classList.remove('on'));
      pin.classList.add('on');
      setTimeout(() => (window.location.href = pin.getAttribute('href')!), reduce ? 150 : 650);
    }

    // Tap, click or Enter on a pin: plug in automatically.
    for (const pin of pins) {
      pin.addEventListener('click', (e) => {
        e.preventDefault();
        plugInto(pin);
      });
    }

    // Drag the plug.
    let dragging = false;
    plug.addEventListener('pointerdown', (e) => {
      if (busy) return;
      dragging = true;
      svg.classList.add('touched', 'dragging');
      plug.setPointerCapture(e.pointerId);
      e.preventDefault();
    });
    plug.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      end = toSvg(e);
      draw();
      const hover = nearest(end);
      pins.forEach((p) => p.classList.toggle('near', p === hover));
    });
    const drop = () => {
      if (!dragging) return;
      dragging = false;
      svg.classList.remove('dragging');
      pins.forEach((p) => p.classList.remove('near'));
      const target = nearest(end);
      if (target) plugInto(target);
      else animateTo({ x: rx, y: ry }, 400);
    };
    plug.addEventListener('pointerup', drop);
    plug.addEventListener('pointercancel', drop);

    // Coming back with the browser's back button: reset the board.
    window.addEventListener('pageshow', () => {
      busy = false;
      pins.forEach((p) => p.classList.remove('on'));
      end = { x: rx, y: ry };
      draw();
    });

    draw();
  }
</script>

<style>
  .board-wrap {
    margin: 1.5rem auto 0;
  }
  .hint {
    color: var(--text-muted);
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
  }
  .board {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Flat, toy-like palette with dark outlines (Tinkercad look). */
  .pcb {
    fill: #2f7d4f;
    stroke: #1d5233;
    stroke-width: 5;
  }
  .hole-ring {
    fill: #d9c36a;
  }
  .hole {
    fill: var(--bg);
  }
  .trace path {
    fill: none;
    stroke: #3f9663;
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .metal {
    fill: #c9ced3;
    stroke: #7c848b;
    stroke-width: 3;
  }
  .metal-dark {
    fill: #5d656c;
  }
  .part-grey {
    fill: #d7dadd;
    stroke: #6f777e;
    stroke-width: 3;
  }
  .btn-red {
    fill: #d84a3a;
    stroke: #8e2a1f;
    stroke-width: 3;
  }
  .chip {
    fill: #2b2f33;
    stroke: #121416;
    stroke-width: 3;
  }
  .chip-pin {
    fill: #c9ced3;
  }
  .chip-dot {
    fill: #4a5056;
  }
  .chip-text {
    fill: #e9ecef;
    font: 700 22px var(--font-mono);
    text-anchor: middle;
  }
  .chip-text.big {
    font-size: 34px;
  }
  .chip-text.tiny {
    font-size: 16px;
  }
  .cap {
    fill: #e0b45c;
    stroke: #9a7430;
    stroke-width: 2;
  }
  .silk {
    fill: #f3f6f2;
    font: 700 16px var(--font-mono);
    text-anchor: middle;
  }
  .silk.small {
    font-size: 14px;
  }
  .silk.start {
    text-anchor: start;
  }
  .silk.end,
  .silk.name {
    text-anchor: end;
  }
  .silk.name {
    font-size: 26px;
    letter-spacing: 2px;
  }
  .silk.label {
    font-size: 21px;
    font-family: var(--font-sans);
  }
  .header {
    fill: #26292c;
    stroke: #111;
    stroke-width: 3;
  }
  .pad {
    fill: #e2bf4a;
    stroke: #8f7420;
    stroke-width: 2;
  }
  .led-pwr {
    fill: #7dff8a;
    stroke: #2e8c3a;
    stroke-width: 2;
  }
  .led {
    fill: #5b3b36;
    stroke: #2a1a17;
    stroke-width: 2;
    transition: fill 0.15s;
  }

  /* Pins are links. */
  .pin {
    cursor: pointer;
  }
  .pin .hit {
    fill: transparent;
    stroke: transparent;
    stroke-width: 3;
  }
  .pin:hover .hit,
  .pin.near .hit {
    fill: rgb(255 255 255 / 0.1);
  }
  .pin:focus-visible {
    outline: none;
  }
  .pin:focus-visible .hit {
    stroke: #ffe066;
    stroke-dasharray: 8 6;
  }
  .pin.near .pad,
  .pin:hover .pad {
    fill: #ffe066;
  }
  .pin.on .led {
    fill: #ff2d1f;
    stroke: #ffd0c8;
    transition: none;
    filter: url(#glow);
  }

  /* The jumper wire. */
  .wire {
    fill: none;
    stroke: #e0392b;
    stroke-width: 9;
    stroke-linecap: round;
  }
  .plug {
    cursor: grab;
    touch-action: none;
  }
  .dragging .plug {
    cursor: grabbing;
  }
  .plug-hit {
    fill: transparent;
  }
  .plug-body {
    fill: #2a2d30;
    stroke: #e0392b;
    stroke-width: 4;
  }
  .plug-tip {
    fill: #c9ced3;
  }
  /* Gentle bob to show the plug can be grabbed, until the first touch. */
  .board:not(.touched) .plug-body,
  .board:not(.touched) .plug-tip {
    animation: bob 1.6s ease-in-out infinite;
  }
  @keyframes bob {
    50% {
      transform: translateY(-6px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .board:not(.touched) .plug-body,
    .board:not(.touched) .plug-tip {
      animation: none;
    }
  }
</style>
