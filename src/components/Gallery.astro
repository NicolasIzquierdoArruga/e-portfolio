---
/**
 * Image gallery with click-to-enlarge.
 * Thumbnails are optimised by Astro (resized, converted to WebP).
 * Clicking one opens it full size in a native <dialog>; Esc or the
 * close button closes it. Without JavaScript the link opens the image file.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  images: { src: ImageMetadata; alt: string; caption?: string }[];
}

const { images } = Astro.props;
// Large version used in the enlarged view.
const large = await Promise.all(images.map((img) => getImage({ src: img.src, width: 1800 })));
---

{
  images.length > 0 && (
    <div class="gallery">
      {images.map((img, i) => (
        <figure>
          <a class="zoom" href={large[i].src} data-full={large[i].src} data-caption={img.caption ?? img.alt}>
            <Image src={img.src} alt={img.alt} widths={[320, 640]} sizes="(min-width: 700px) 320px, 100vw" />
          </a>
          {img.caption && <figcaption>{img.caption}</figcaption>}
        </figure>
      ))}
    </div>
  )
}

<dialog class="lightbox" aria-label="Enlarged image">
  <button class="close btn" type="button" aria-label="Close">Close ✕</button>
  <img alt="" />
  <p class="caption"></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox');
  const bigImg = dialog?.querySelector('img');
  const caption = dialog?.querySelector('.caption');

  for (const link of document.querySelectorAll<HTMLAnchorElement>('.gallery a.zoom, a.zoom')) {
    link.addEventListener('click', (event) => {
      if (!dialog || !bigImg || !caption) return;
      event.preventDefault();
      bigImg.src = link.dataset.full ?? link.href;
      bigImg.alt = link.querySelector('img')?.alt ?? '';
      caption.textContent = link.dataset.caption ?? '';
      dialog.showModal();
    });
  }
  dialog?.querySelector('.close')?.addEventListener('click', () => dialog.close());
  // Click on the dark backdrop closes the dialog too.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>

<style>
  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    margin: 0 0 1.5rem;
  }
  figure {
    margin: 0;
  }
  .zoom {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: #fff;
    cursor: zoom-in;
  }
  .zoom :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
  .lightbox {
    max-width: min(96vw, 1400px);
    max-height: 94vh;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
  }
  .lightbox::backdrop {
    background: rgb(0 0 0 / 0.75);
  }
  .lightbox img {
    display: block;
    max-height: 80vh;
    margin: 0 auto;
    background: #fff;
  }
  .close {
    float: right;
    margin-bottom: 0.5rem;
  }
  .caption {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
