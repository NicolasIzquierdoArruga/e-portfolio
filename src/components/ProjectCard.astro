---
/** One project in a grid: thumbnail, title, one-line summary, tags. */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, tags, thumbnail, thumbnailAlt, context, period, status } = project.data;
---

<article class="project-card" data-tags={tags.join('|')}>
  <a class="cover" href={url(`/projects/${project.id}`)} tabindex="-1" aria-hidden="true">
    {
      thumbnail ? (
        <Image src={thumbnail} alt="" widths={[400, 800]} sizes="(min-width: 900px) 360px, 100vw" />
      ) : (
        <span class="no-image">{title}</span>
      )
    }
  </a>
  <div class="body">
    <p class="meta">
      {status === 'in-progress' && <span class="status">In progress</span>}
      {context} · {period}
    </p>
    <h3><a href={url(`/projects/${project.id}`)}>{title}</a></h3>
    <p class="summary">{summary}</p>
    <ul class="tag-list" aria-label="Tags">
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
  </div>
  {thumbnailAlt && <span class="visually-hidden">{thumbnailAlt}</span>}
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.15s;
  }
  .project-card:hover {
    border-color: var(--accent);
  }
  .cover {
    display: block;
    aspect-ratio: 16 / 9;
    background: #ffffff;
    border-bottom: 1px solid var(--border);
  }
  .cover {
    overflow: hidden;
  }
  /* Diagrams (SVG) are shown whole; photos fill the frame. */
  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cover :global(img[src$='.svg']) {
    object-fit: contain;
    padding: 0.5rem;
  }
  .no-image {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    font-family: var(--font-mono);
    color: #555e66;
    text-align: center;
  }
  .body {
    padding: 1rem 1.1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .meta {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin: 0;
  }
  .status {
    display: inline-block;
    margin-right: 0.4rem;
    padding: 0 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--warn-border);
    background: var(--warn-bg);
    color: var(--text);
    font-weight: 600;
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.97rem;
    flex: 1;
  }
</style>
