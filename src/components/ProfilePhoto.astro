---
/**
 * Profile photo. Drop a file named profile.jpg (or .png / .webp) into
 * src/assets/ and it appears automatically, optimised by Astro.
 * Until then, initials are shown instead.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';

const found = import.meta.glob<{ default: ImageMetadata }>('../assets/profile.{jpg,jpeg,png,webp}', { eager: true });
const photo = Object.values(found)[0]?.default;
---

<div class="photo">
  {
    photo ? (
      <Image src={photo} alt={`Portrait of ${SITE.name}`} width={320} height={320} loading="eager" />
    ) : (
      <span aria-hidden="true">NI</span>
    )
  }
</div>

<style>
  .photo {
    width: clamp(7rem, 22vw, 11rem);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--accent-soft);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  span {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    color: var(--accent);
  }
</style>
